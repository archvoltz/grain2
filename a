import { Inject, Injectable, NestMiddleware } from '@nestjs/common';
import { NextFunction, Request, Response } from 'express';
import { APP_LOGGER } from '../logger/app-logger';
import type { AppLogger } from '../logger/app-logger';
import { RequestContextService } from '../requestContext.service';
import type { RequestErrorContext } from '../logger/log-line';

export const REQUEST_ID_HEADER = 'x-request-id';

/**
 * 例外フィルタが結果を積む Request。
 *
 * requestId / userId は AsyncLocalStorage へ移したのでここには持たない。
 * どちらも同じリクエストの中なので ALS でも運べるが、「1 リクエストに
 * 1 個しか無い可変の受け渡し箱」であって context (リクエストの素性) ではない
 * ので request に置いたままにしている。
 */
export interface RequestWithErrorInfo extends Request {
  errorInfo?: RequestErrorContext;
}

/**
 * クライアント IP。nginx / compose 経由だと socket は上流のものになるので
 * x-forwarded-for の先頭を優先する。取れなければ空文字。
 */
function clientIpOf(req: Request): string {
  const xff = req.headers['x-forwarded-for'];
  const first = Array.isArray(xff) ? xff[0] : xff;
  if (first) return first.split(',')[0].trim();
  return req.socket?.remoteAddress ?? '';
}

@Injectable()
export class HttpLoggerMiddleware implements NestMiddleware {
  constructor(
    // 具象クラスではなく token で受ける。
// pino などへ差し替えてもここは触らずに済む。
    @Inject(APP_LOGGER) private readonly logger: AppLogger,
    private readonly requestContext: RequestContextService,
  ) {}

  use(req: RequestWithErrorInfo, res: Response, next: NextFunction) {
    const header = req.headers[REQUEST_ID_HEADER];
    const context = this.requestContext.create({
      clientIp: clientIpOf(req),
      UserAgent: req.headers['user-agent'],
      requestId: Array.isArray(header) ? header[0] : header,
    });
    res.setHeader(REQUEST_ID_HEADER, context.requestId);

    const startedAt = Date.now();
    res.on('finish', () => {
      // 例外フィルタが積んだものを拾う。filter はレスポンス送出時に走るので
      // finish の時点では必ず入っている。無ければ error キーは出力されない。
      const errorInfo = req.errorInfo;

      // finish は res.end() を呼んだ側の文脈で emit される。ふつうはハンドラ
      // (= context の中) だが、そうならない経路もあるので **作った context に
      // 明示的に入り直す**。ここを ALS 任せにすると requestId が空の行が
      // まれに出て、原因が分からなくなる。
      this.requestContext.run(context, () =>
        this.logger.httpAccess(
          {
            method: req.method,
            path: req.originalUrl,
            status: res.statusCode,
            durationMs: Date.now() - startedAt,
          },
          { message: errorInfo?.message, error: errorInfo?.error },
        ),
      );
    });

    // 以降の middleware / guard / controller / service はすべてこの中で走る。
    this.requestContext.run(context, () => next());
  }
}


