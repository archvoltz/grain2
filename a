import type { AppErrorCode } from '../interfaces/error-response.interface';

export type LogEvent =
  | 'http_request' // HTTP リクエスト 1 件の完了ごと（成否によらず）
  | 'login_succeeded'
  | 'login_failed'
  | 'logout'
  | 'app_started';
// 行動分析で使う予定の予約語（実装するまで使わない）:
//   page_viewed / element_clicked / session_started / session_ended

/** 全ログ共通のキー。順序もこの通りに出力する。 */
export interface LogFields {
  clientIp: string;
  timestamp: string; // ISO8601 UTC
  severity: 'INFO' | 'WARN' | 'ERROR' | 'DEBUG';
  service: string;
  version: string;
  event: LogEvent | '';
  requestId: string;
  userId: string;
  message: string;
  UserAgent: string; // 指定どおり大文字始まり
}

/** HTTP アクセスログだけが足す項目。 */
export interface HttpFields {
  method: string;
  path: string;
  status: number;
  durationMs: number;
}

export interface ErrorFields {
  code: AppErrorCode | ''; // front/back で語彙共通
  type: string; // 例外クラス名
  detail: string; // 内部向け補足
  stack: string; // ログには常に入れる。クライアントへ返さないだけ
}

export interface RequestErrorContext {
  message: string;
  error: ErrorFields;
}

export function appErrorCodeFromStatus(status: number): AppErrorCode {
  switch (status) {
    case 400:
      return 'BAD_REQUEST';
    case 401:
      return 'UNAUTHORIZED';
    case 403:
      return 'FORBIDDEN';
    case 404:
      return 'NOT_FOUND';
    case 409:
      return 'CONFLICT';
    case 422:
      return 'VALIDATION_ERROR';
    case 429:
      return 'RATE_LIMITED';
    default:
      return status >= 500 ? 'INTERNAL_ERROR' : 'UNKNOWN_ERROR';
  }
}

/**
 * HTTP ステータス → `severity`。
 *
 * `appErrorCodeFromStatus` と同じく「ステータスから決まる語彙」なので隣に置く。
 * 4xx を WARN にしているのは、クライアント起因の失敗で ERROR の件数を
 * 膨らませないため (アラートはサーバ起因の 5xx で鳴らしたい)。
 */
export function severityFromStatus(status: number): LogFields['severity'] {
  if (status >= 500) return 'ERROR';
  if (status >= 400) return 'WARN';
  return 'INFO';
}

/**
 * service / version は **呼ばれるたびに読む**。モジュール読み込み時に定数へ
 * 束ねると、ConfigModule.forRoot() が .env を読むより前に評価されてしまい、
 * 常に既定値になる (実際に version が 0.0.0 のまま出て気づいた)。
 */
const serviceName = () => process.env.LOG_SERVICE || 'w3x-api';
const appVersion = () => process.env.APP_VERSION || '0.0.0';

/** stack の最大長。_source の保存量と転送量を抑えるため。 */
export const STACK_MAX_BYTES = 4096;

/** undefined / null を空文字に落とす。 */
const s = (v: unknown): string =>
  v === undefined || v === null ? '' : String(v);

/** stack を 4KB で切る。切ったことが分かるよう印を残す。 */
export function truncateStack(stack: unknown): string {
  const text = s(stack);
  if (Buffer.byteLength(text, 'utf8') <= STACK_MAX_BYTES) return text;
  // マルチバイトの途中で切れないよう Buffer 単位で詰めてから復元する
  const cut = Buffer.from(text, 'utf8')
    .subarray(0, STACK_MAX_BYTES)
    .toString('utf8');
  return `${cut}\n...[truncated at ${STACK_MAX_BYTES} bytes]`;
}

/** 共通フィールドを既定値で埋めて返す。 */
export function buildLogFields(partial: Partial<LogFields> = {}): LogFields {
  return {
    clientIp: s(partial.clientIp),
    timestamp: partial.timestamp || new Date().toISOString(),
    severity: partial.severity || 'INFO',
    service: partial.service || serviceName(),
    version: partial.version || appVersion(),
    event: partial.event || '',
    requestId: s(partial.requestId),
    userId: s(partial.userId),
    message: s(partial.message),
    UserAgent: s(partial.UserAgent),
  };
}

/**
 * 1 行の JSON にする。改行を含めないこと（1 リクエスト 1 行が前提）。
 * `error` はエラー時のみ渡す。渡さなければキー自体が出ない。
 */
export function formatLogLine(
  partial: Partial<LogFields> = {},
  extra: Partial<HttpFields> = {},
  error?: Partial<ErrorFields>,
): string {
  const merged: Record<string, unknown> = { ...buildLogFields(partial) };

  // HTTP 項目は存在するときだけ、共通項目の後ろに足す
  if (extra.method !== undefined) merged.method = s(extra.method);
  if (extra.path !== undefined) merged.path = s(extra.path);
  if (extra.status !== undefined) merged.status = extra.status;
  if (extra.durationMs !== undefined) merged.durationMs = extra.durationMs;

  if (error) {
    merged.error = {
      code: s(error.code),
      type: s(error.type),
      detail: s(error.detail),
      stack: truncateStack(error.stack),
    };
  }
  return JSON.stringify(merged);
}


