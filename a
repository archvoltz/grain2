import { AsyncLocalStorage } from 'node:async_hooks';
import { randomUUID } from 'node:crypto';
import { Injectable } from '@nestjs/common';

export interface RequestContext {
  clientIp: string;
  /** 共通ログ行のキーに合わせて大文字始まり。 */
  UserAgent: string;
  requestId: string;
  userId: string;
}

const storage = new AsyncLocalStorage<RequestContext>();

/** undefined / null を空文字に落とす。 */
const s = (v: unknown): string =>
  v === undefined || v === null ? '' : String(v);

@Injectable()
export class RequestContextService {
  create(seed: Partial<RequestContext> = {}): RequestContext {
    return {
      clientIp: s(seed.clientIp),
      UserAgent: s(seed.UserAgent),
      requestId: s(seed.requestId) || randomUUID(),
      userId: s(seed.userId),
    };
  }

  /** context を張ってから fn を実行する。fn の中の非同期処理にも引き継がれる。 */
  run<T>(context: RequestContext, fn: () => T): T {
    return storage.run(context, fn);
  }

  get(): RequestContext | undefined {
    return storage.getStore();
  }

  setUserId(userId: unknown): void {
    const context = storage.getStore();
    const value = s(userId);
    if (!context || !value) return;
    context.userId = value;
  }
}



