import { Injectable } from '@nestjs/common';
import Redis from 'ioredis';
import { RequestContextService } from '../requestContext.service';
// import * as RedisSession from './redis-session.js';
@Injectable()
export class RedisService {
  private readonly redis = new Redis(process.env.REDIS_URL);
  private readonly options = {
    client: this.redis,
    ttl: parseInt(process.env.SESSION_EXPIRES, 10),
  };
  private readonly redisSession = new RedisSession(this.options);

  constructor(private readonly requestContext: RequestContextService) {}

  async createSession(_sessionId: string, _sessionData: any): Promise<void> {
    await this.redisSession.set(_sessionId, _sessionData);
    this.requestContext.setUserId(_sessionData?.userId);
  }

  async getSession(_sessionId: string): Promise<any> {
    const sessionData = await this.redisSession.get(_sessionId);
    if (!sessionData) return;
    const newSession = await this.updateSession(_sessionId, sessionData);
    this.redisSession.touch(_sessionId, newSession);
    this.requestContext.setUserId(newSession?.userId);
    return newSession;
  }

  async updateSession(_sessionId: string, _sessionData: any): Promise<any> {
    const sess = _sessionData;
    const newExpire = new Date(
      Date.now() + parseInt(process.env.SESSION_EXPIRES, 10) * 1000,
    );
    sess.expires = newExpire;
    this.redisSession.set(_sessionId, sess);
    return sess;
  }

  async deleteSession(_sessionId: string): Promise<void> {
    await this.redisSession.destroy(_sessionId);
  }
}

class RedisSession {
  private prefix;
  private scanCount;
  private serializer;
  private client;
  private ttl;
  private disableTTL;
  private disableTouch;
  constructor(options: any) {
    this.prefix = '';
    this.scanCount = Number(options.scanCount) || 100;
    this.serializer = options.serializer || JSON;
    this.client = options.client;
    this.ttl = options.ttl || 1800; // 30 minutes
    this.disableTTL = options.disableTTL || false;
    this.disableTouch = options.disableTouch || false;
  }

  async get(sid) {
    const key = this.prefix + sid;

    const data = await this.client.get(key);
    if (!data) return null;

    let value;
    try {
      value = this.serializer.parse(data);
    } catch (err) {
      return null;
    }
    return value;
  }

  async set(sid, sess) {
    const args = [this.prefix + sid];

    let value;
    try {
      value = this.serializer.stringify(sess);
    } catch (er) {
      return null;
    }
    args.push(value);

    let ttl = 1;
    if (!this.disableTTL) {
      ttl = this._getTTL(sess);
      args.push('EX', ttl);
    }

    if (ttl > 0) {
      return await this.client.set(args);
    } else {
      // If the resulting TTL is negative we can delete / destroy the key
      return await this.destroy(sid);
    }
  }

  async touch(sid, sess) {
    if (this.disableTouch || this.disableTTL) return null;
    const key = this.prefix + sid;
    const err = await this.client.expire(key, this._getTTL(sess));
    return err;
  }

  async destroy(sid) {
    const key = this.prefix + sid;
    const err = await this.client.del(key);
    return err;
  }

  async clear() {
    const keys = await this.client.keys(this.prefix + '*');
    if (!keys) return null;

    keys.forEach(async (key) => {
      await this.client.del(key);
    });
  }

  _getTTL(sess) {
    let ttl;
    if (sess && sess.expires) {
      const ms = Number(new Date(sess.expires)) - Date.now();
      ttl = Math.ceil(ms / 1000);
    } else {
      ttl = this.ttl;
    }
    return ttl;
  }
}


